# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file contains placeholders only. Copy it to ".env" and replace the
# placeholders with credentials for your own local services.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET="replace-with-a-random-secret"

# Better Auth GitHub OAuth
BETTER_AUTH_GITHUB_CLIENT_ID="replace-with-github-client-id"
BETTER_AUTH_GITHUB_CLIENT_SECRET="replace-with-github-client-secret"

# Local Docker Compose database password placeholder. Use the same value below.
POSTGRES_PASSWORD="local-development-only"

# Drizzle
DATABASE_URL="postgresql://postgres:local-development-only@localhost:5432/audio-forge"

# Redis (for BullMQ)
REDIS_URL="redis://localhost:6379"

# Cloudflare R2
CLOUDFLARE_R2_ENDPOINT="https://replace-with-account-id.r2.cloudflarestorage.com"
CLOUDFLARE_R2_ACCESS_KEY_ID="replace-with-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="replace-with-secret-access-key"
CLOUDFLARE_R2_BUCKET="replace-with-bucket-name"
CLOUDFLARE_R2_TEMP_BUCKET="temp-audio-forge"

# Pyannote (speaker diarization)
PYANNOTE_API_KEY="replace-with-pyannote-api-key"
PYANNOTE_WEBHOOK_URL="https://replace-with-public-webhook-url/api/webhooks/diarization"

# VibeVoice ASR service
VIBEVOICE_ASR_URL="http://localhost:8001"

# Speech processing service used for denoising and quality scoring
SPEECH_PROCESSING_SERVER_URL="http://localhost:8000"

# Media Server
MEDIA_SERVER_URL="http://localhost:3002"
NEXT_PUBLIC_MEDIA_SERVER_URL="http://localhost:3002"
