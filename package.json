    "@trpc/server": "^11.7.2",
    "better-auth": "^1.4.5",
    "drizzle-orm": "^0.45.0",
    "next": "^15.5.7",
    "postgres": "^3.4.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "server-only": "^0.0.1",
    "superjson": "^2.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
